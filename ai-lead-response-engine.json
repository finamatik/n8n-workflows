      "name": "AI: qualify lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Live mode: same node pointed at api.anthropic.com/v1/messages with the credential; prompt asks for {score,intent,summary,reply,next_step} JSON."
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Normalise + dedupe (24h)').first().json;\nlet ai = $input.first().json.output;\nif (typeof ai === 'string') { try { ai = JSON.parse(ai); } catch (e) { ai = { reply: ai }; } }\nai = (ai && typeof ai === 'object') ? ai : {};\n// The score is 0 to 100 and the threshold in Config is on the same scale. The\n// request says so, because a model answering 0 to 10 would never produce a\n// hot lead and nobody would notice.\nconst score = Math.max(0, Math.min(100, Number(ai.score) || 0));\nconst reply = String(ai.reply || '').trim();\nreturn [{ json: { ...lead, ai, score, hot: score >= Number(lead.cfg.hot_threshold), reply, reply_ok: reply.length >= 10, usage: $input.first().json.usage } }];"
      },
      "name": "Merge lead + AI verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ]
    },
