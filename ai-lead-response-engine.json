        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ task: 'qualify_lead', score_scale: '0 to 100, where 70 and above is worth a call within the hour', input: { name: $json.name, service: $json.service, message: $json.message, company: $json.company, budget: $json.budget } }) }}",
        "options": {
