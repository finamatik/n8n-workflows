    {
      "parameters": {
        "jsCode": "// Normalise any lead source into one shape and drop duplicates within 24h (workflow static data).\nconst body = $input.first().json.body || $input.first().json;\nconst cfg = $('Config').first().json;\nconst lead = {\n  name: body.name || body.full_name || [body.first_name, body.last_name].filter(Boolean).join(' ') || 'Unknown',\n  email: (body.email || '').toLowerCase().trim(),\n  phone: (body.phone || body.phone_number || '').replace(/[^+\\d]/g, ''),\n  service: body.service || body.interest || body.form_name || 'general enquiry',\n  message: body.message || body.notes || body.comments || '',\n  source: body.source || body.utm_source || 'web-form',\n  company: body.company || '', budget: body.budget || '',\n  received_at: new Date().toISOString()\n};\n// A lead with no way to reach them is not an error to throw, because a thrown\n// error answers the form platform with a 500 and it retries the same lead\n// for hours. It is answered with a reason and handed to a person.\nlead.usable = !!(lead.email || lead.phone);\nlead.reject_reason = lead.usable ? '' : 'neither email nor phone on the lead';\n\n// Duplicate within 24h. The seen list is only READ here and written in\n// \"Respond to webhook\" once the lead has actually been handled, so a run that\n// fails at the model or the CRM leaves the lead unmarked and the platform's\n// retry handles it instead of skipping it.\nconst key = lead.email || lead.phone || '';\nconst seen = $getWorkflowStaticData('global'); seen.leads = seen.leads || {};\nconst last = key ? seen.leads[key] : null;\nlead.duplicate = !!(last && Date.now() - last < 24*3600*1000);\nreturn [{ json: { ...lead, cfg } }];"
      },
      "name": "Normalise + dedupe (24h)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
