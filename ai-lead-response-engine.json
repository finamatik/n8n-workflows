    {
      "parameters": {
        "jsCode": "const l = $('Attach contact id').first().json;\n// Only now is the lead marked as handled, so a failed attempt is retried by the platform.\nconst seen = $getWorkflowStaticData('global'); seen.leads = seen.leads || {};\nseen.leads[l.email || l.phone] = Date.now();\nreturn [{ json: { ok: true, lead: l.name, score: l.score, route: l.hot ? 'hot: replied + slots offered + rep task' : 'nurture sequence started', contact_id: l.contact_id, tokens: l.usage } }];"
